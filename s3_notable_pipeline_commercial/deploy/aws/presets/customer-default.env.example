# Commercial AWS customer-default SAM preset (copy and fill)
#
# Matches on-prem CAPABILITY_PROFILES=core,rag,analyst_portal with portal SPL
# dictionary grounding. Does not enable spl_readonly, elastic_readonly,
# action_gated, or closed-ticket RAG (enable optional block below when approved).
#
# Usage (bash):
#   cp deploy/aws/presets/customer-default.env.example customer-default.env
#   # edit customer-default.env
#   set -a && source customer-default.env && set +a
#   sam build -t deploy/aws/template-sam.yaml
#   sam deploy --template-file .aws-sam/build/template.yaml --region us-east-1 \
#     --capabilities CAPABILITY_IAM \
#     --parameter-overrides \
#       AwsAccountId="$AWS_ACCOUNT_ID" \
#       EcrRepositoryUri="$ECR_REPOSITORY_URI" \
#       ImageDigest="$IMAGE_DIGEST" \
#       BedrockAnalysisModelId="$BEDROCK_ANALYSIS_MODEL_ID" \
#       BedrockAnalysisModelArn="$BEDROCK_ANALYSIS_MODEL_ARN" \
#       BedrockAnalysisInferenceProfileFoundationModelArns="$BEDROCK_ANALYSIS_INFERENCE_PROFILE_FOUNDATION_MODEL_ARNS" \
#       InputBucketName="$INPUT_BUCKET_NAME" \
#       OutputBucketName="$OUTPUT_BUCKET_NAME" \
#       CapabilityProfiles=core,rag,analyst_portal \
#       SplunkSinkMode=s3 \
#       HtmlReportEnabled=false \
#       RagEnabled=true \
#       RagIngestionEnabled=true \
#       SplQueryRagEnabled=true \
#       PortalEnabled=true \
#       CaseArchiveEnabled=true \
#       CaseQaEnabled=true \
#       CaseIndexTableName="$CASE_INDEX_TABLE_NAME" \
#       PortalUiBucketName="$PORTAL_UI_BUCKET_NAME" \
#       PortalAuthMode=jwt \
#       PortalJwtIssuer="$PORTAL_JWT_ISSUER" \
#       PortalJwtAudience="$PORTAL_JWT_AUDIENCE" \
#       PortalRequiredAnalystRole="$PORTAL_REQUIRED_ANALYST_ROLE" \
#       PortalRequiredAnalystScope="$PORTAL_REQUIRED_ANALYST_SCOPE" \
#       PortalCorsAllowedOrigins="$PORTAL_CORS_ALLOWED_ORIGINS" \
#       OpenSearchEndpoint="$OPENSEARCH_ENDPOINT" \
#       OpenSearchDomainArn="$OPENSEARCH_DOMAIN_ARN" \
#       OpenSearchSocIndex="$OPENSEARCH_SOC_INDEX" \
#       OpenSearchSplunkIndex="$OPENSEARCH_SPLUNK_INDEX" \
#       OpenSearchCaseIndex="$OPENSEARCH_CASE_INDEX" \
#       RagTenantId="$RAG_TENANT_ID" \
#       CustomerVpcSubnetIds="$CUSTOMER_VPC_SUBNET_IDS" \
#       CustomerSecurityGroupIds="$CUSTOMER_SECURITY_GROUP_IDS" \
#       CustomerKmsKeyArn="$CUSTOMER_KMS_KEY_ARN"
#
# Full checklist: docs/operations/deployment/COMMERCIAL_AWS_CUSTOMER_DEFAULT_DEPLOYMENT.md
# OpenSearch first: docs/operations/deployment/OPENSEARCH_PROVISIONING.md

# --- Required: image and account (publish to ECR before deploy) ---
# AWS_ACCOUNT_ID feeds SAM AwsAccountId and ECR URIs. setup-and-deploy scripts
# validate COMMERCIAL_AWS_ACCOUNT_ID — keep both identical.
AWS_ACCOUNT_ID=
COMMERCIAL_AWS_ACCOUNT_ID=
ECR_REPOSITORY_URI=
IMAGE_DIGEST=

# --- Required: Bedrock analysis model ---
BEDROCK_ANALYSIS_MODEL_ID=
BEDROCK_ANALYSIS_MODEL_ARN=
# Required only for a geographic cross-region inference profile; comma-separated, no wildcards.
BEDROCK_ANALYSIS_INFERENCE_PROFILE_FOUNDATION_MODEL_ARNS=

# --- Required: S3 buckets (globally unique) ---
INPUT_BUCKET_NAME=
OUTPUT_BUCKET_NAME=

# --- Required: portal and CaseIndex ---
CASE_INDEX_TABLE_NAME=notable-case-index
PORTAL_UI_BUCKET_NAME=
PORTAL_JWT_ISSUER=
PORTAL_JWT_AUDIENCE=
# Required for JWT portal: set PORTAL_REQUIRED_ANALYST_ROLE and/or PORTAL_REQUIRED_ANALYST_SCOPE.
# SAM deploy fails if both are empty when PortalEnabled=true and PortalAuthMode=jwt.
PORTAL_REQUIRED_ANALYST_ROLE=
PORTAL_REQUIRED_ANALYST_SCOPE=
PORTAL_CORS_ALLOWED_ORIGINS=

# --- Required: OpenSearch (VPC-only domain; provision before SAM deploy) ---
# See docs/operations/deployment/OPENSEARCH_PROVISIONING.md
OPENSEARCH_ENDPOINT=
OPENSEARCH_DOMAIN_ARN=
RAG_TENANT_ID=

# --- Required: Lambda VPC path to OpenSearch ---
CUSTOMER_VPC_SUBNET_IDS=
CUSTOMER_SECURITY_GROUP_IDS=

# --- OpenSearch index names (SAM defaults; override only when customer policy requires) ---
OPENSEARCH_SOC_INDEX=soc_knowledge
OPENSEARCH_SPLUNK_INDEX=splunk_dictionary
OPENSEARCH_CASE_INDEX=case_chunks

# --- Optional: customer CMK for production encryption ---
CUSTOMER_KMS_KEY_ARN=

# --- Optional: closed-ticket RAG vertical slice (shipped; opt-in — not in baseline preset) ---
# SERVICENOW_CLOSED_TICKET_SYNC_ENABLED=true
# SERVICENOW_CLOSED_TICKET_TOKEN_SECRET_ARN=
# CLOSED_TICKET_RAG_ENABLED=true
# CLOSED_TICKET_EMBED_ENABLED=true
# CASE_QA_CLOSED_TICKET_ENABLED=true
# OPENSEARCH_CLOSED_TICKET_INDEX=closed_tickets
# CLOSED_TICKET_VISION_ENABLED=false
#
# --- Optional: retrieval rerank and portal chat images (shipped; opt-in — not in baseline preset) ---
# RAG_RERANK_ENABLED=false
# RAG_RERANK_MODEL_ARN=
# CASE_QA_CHAT_IMAGES_ENABLED=false
