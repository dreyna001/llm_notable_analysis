aws_account_id = "123456789012"
key_alias      = "alias/notable-analyzer-staging"

admin_principal_arns = [
  "arn:aws:iam::123456789012:role/ApprovedKmsAdministrator",
]

# Phase B: add physical Lambda role ARNs after the first SAM deploy.
lambda_role_arns = [
  # "arn:aws:iam::123456789012:role/notable-analyzer-stack-NotableAnalyzerFunctionRole-abc123",
  # "arn:aws:iam::123456789012:role/notable-analyzer-stack-CaseEmbedFunctionRole-def456",
  # "arn:aws:iam::123456789012:role/notable-analyzer-stack-RagIngestionFunctionRole-ghi789",
  # "arn:aws:iam::123456789012:role/notable-analyzer-stack-PortalApiFunctionRole-jkl012",
]

enable_opensearch_grant = true
enable_key_rotation     = true

tags = {
  Environment = "staging"
  Owner       = "security-platform"
}
