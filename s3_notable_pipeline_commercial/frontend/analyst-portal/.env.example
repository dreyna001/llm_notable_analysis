# Default backward-compatible browser auth.
VITE_PORTAL_AUTH_MODE=manual

# Optional cross-origin API URL. Leave empty for the same-origin deployment.
VITE_PORTAL_API_BASE_URL=

# Entra mode: set VITE_PORTAL_AUTH_MODE=entra and provide every required value.
# These values identify public applications and are not secrets.
# VITE_PORTAL_ENTRA_TENANT_ID=<entra-directory-tenant-guid>
# VITE_PORTAL_ENTRA_CLIENT_ID=<spa-application-client-id>
# VITE_PORTAL_ENTRA_API_SCOPE=api://<api-application-client-id>/portal.analyst
# VITE_PORTAL_ENTRA_REDIRECT_URI=https://<portal-hostname>/
# VITE_PORTAL_ENTRA_POST_LOGOUT_URI=https://<portal-hostname>/
