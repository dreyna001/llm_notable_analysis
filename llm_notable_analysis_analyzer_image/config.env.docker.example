# Docker-oriented analyzer config. Copy to config.env and edit before compose up.
# Full contract: ../llm_notable_analysis_onprem_systemd/config.env.example

INGEST_MODE=file_drop
CAPABILITY_PROFILES=core

INCOMING_DIR=/var/notables/incoming
PROCESSED_DIR=/var/notables/processed
QUARANTINE_DIR=/var/notables/quarantine
REPORT_DIR=/var/notables/reports
ARCHIVE_DIR=/var/notables/archive

POLL_INTERVAL=5
MAX_INPUT_FILE_BYTES=4194304

# LiteLLM on the Docker host (change if you add a litellm service to compose).
LLM_API_URL=http://host.docker.internal:4000/v1/chat/completions

# Optional healthcheck tuning (see README).
# ANALYZER_HEALTHCHECK_CHECK_LLM=true
# ANALYZER_HEALTHCHECK_CHECK_POSTGRES=true
# ANALYZER_HEALTHCHECK_TIMEOUT_SECONDS=5
LLM_API_TOKEN=
LLM_MODEL_NAME=gemma-4-31B-it
LLM_STRUCTURED_OUTPUT_MODE=prompt_json
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

RAG_ENABLED=false
RAG_FAIL_CLOSED=false
RAG_BACKEND=postgres

# Enable when running the optional postgres service in docker-compose.yml:
# CAPABILITY_PROFILES=core,rag
# RAG_ENABLED=true
# RAG_POSTGRES_DSN=postgresql://notable_analyzer:notable_analyzer@postgres:5432/notable_rag
