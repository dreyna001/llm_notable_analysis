# On-prem Notable Analysis Service Configuration
# Copy to /etc/notable-analyzer/config.env and edit values

# =============================================================================
# Ingest Mode
# =============================================================================
# Ingest mode: file_drop (SOAR pushes notables via SFTP to INCOMING_DIR)
# This is the only supported ingest mode. See README.md for SFTP setup.
INGEST_MODE=file_drop

# =============================================================================
# Capability Profiles
# =============================================================================
# Profiles name supported bundles of feature flags. Keep core as the baseline
# and add only the capabilities this deployment should run.
# Supported: core, html_reports, rag, spl_readonly, elastic_readonly, ticket_draft, action_gated
# Example: CAPABILITY_PROFILES=core,html_reports,rag,spl_readonly
CAPABILITY_PROFILES=core

# =============================================================================
# Directories (for file_drop mode)
# =============================================================================
INCOMING_DIR=/var/notables/incoming
PROCESSED_DIR=/var/notables/processed
QUARANTINE_DIR=/var/notables/quarantine
REPORT_DIR=/var/notables/reports
ARCHIVE_DIR=/var/notables/archive

# Legacy/lab direct flag. If html_reports is selected in CAPABILITY_PROFILES,
# the profile takes precedence over this baseline false value.
HTML_REPORT_ENABLED=false

# Polling interval in seconds
POLL_INTERVAL=5

# Max incoming notable file size in bytes (quarantine if larger; checked before read)
MAX_INPUT_FILE_BYTES=4194304

# =============================================================================
# Local LLM Configuration (LiteLLM -> vLLM)
# =============================================================================
# Tuned for gemma-4-31B-it on RTX PRO 6000 (96 GB) with vLLM --max-model-len 32768.
# LiteLLM endpoint (localhost HTTP - no TLS needed for local). LiteLLM should
# route this model to the local vLLM backend.
LLM_API_URL=http://127.0.0.1:4000/v1/chat/completions

# Optional API token (leave empty if LiteLLM runs without auth on loopback)
LLM_API_TOKEN=

# Model id for JSON "model" (OpenAI-compatible). Must match the server:
#   curl -sS http://127.0.0.1:4000/v1/models
# Default LiteLLM model name for this package:
LLM_MODEL_NAME=gemma-4-31B-it

# Structured output mode:
# - prompt_json: current prompt+parse+repair flow (default)
# - tool_call: OpenAI-compatible function/tool call output with prompt_json fallback
LLM_STRUCTURED_OUTPUT_MODE=prompt_json

# Max tokens for LLM response
LLM_MAX_TOKENS=4096

# Timeout for LLM API calls in seconds. 240 supports spl_readonly plus query
# interpretation (three LLM calls). Core-only deployments may use 120.
LLM_TIMEOUT=240

# =============================================================================
# Retrieval Grounding (Optional)
# =============================================================================
# Legacy/lab direct flag. If rag is selected in CAPABILITY_PROFILES, the profile
# takes precedence over this baseline false value.
RAG_ENABLED=false

# If true, RAG initialization/context failures stop analysis instead of
# degrading to no retrieval context. Keep false for advisory-only deployments;
# set true when operators require KB grounding for every report.
RAG_FAIL_CLOSED=false

# Retrieval backend:
# - postgres: default production backend (PostgreSQL FTS + pgvector + BGE reranker)
# - sqlite_faiss: local fallback (SQLite FTS5 + FAISS files)
RAG_BACKEND=postgres

# Fallback retrieval artifacts for RAG_BACKEND=sqlite_faiss
RAG_SQLITE_PATH=/opt/llm-notable-analysis/knowledge_base/index/kb.sqlite3
RAG_FAISS_PATH=/opt/llm-notable-analysis/knowledge_base/index/kb.faiss

# Target Postgres retrieval contract. Prefer secrets outside this file for
# passwords (for example .pgpass, service files, or host-managed config).
RAG_POSTGRES_DSN=postgresql://notable_analyzer@127.0.0.1:5432/notable_rag
RAG_POSTGRES_SCHEMA=notable_rag
RAG_POSTGRES_CHUNKS_TABLE=kb_chunks
RAG_POSTGRES_FTS_CONFIG=english
# Per-query Postgres timeout for runtime retrieval. Keep bounded to avoid
# analyzer threads waiting indefinitely on slow searches.
RAG_POSTGRES_STATEMENT_TIMEOUT_MS=5000
RAG_VECTOR_DIMENSIONS=768

# Local embedding and reranking models
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# Model/runtime cache paths. The packaged systemd units set these to writable
# paths under /var/notables/cache so RAG model loading works with
# ProtectSystem=strict.
HF_HOME=/var/notables/cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/var/notables/cache/sentence-transformers

# Context limits by LLM profile
RAG_MAX_SNIPPETS_120B=5
RAG_MAX_SNIPPETS_20B=4
RAG_CONTEXT_BUDGET_CHARS_120B=2200
RAG_CONTEXT_BUDGET_CHARS_20B=1600

# Retrieval candidate and quality-gate tuning. These defaults keep context
# narrow and deterministic; increase only after measuring retrieval quality and
# prompt budget impact.
RAG_FUSED_RANK_LIMIT_120B=8
RAG_FUSED_RANK_LIMIT_20B=6
RAG_NEAR_DUPLICATE_SIMILARITY_THRESHOLD=0.80
RAG_LEXICAL_TOP_K=30
RAG_VECTOR_TOP_K=30
RAG_CANDIDATE_POOL_LIMIT=40
RAG_RRF_K=60

# =============================================================================
# Splunk Integration (Optional)
# =============================================================================
# Legacy/lab direct flag. If action_gated is selected in CAPABILITY_PROFILES,
# the profile takes precedence over this baseline false value.
SPLUNK_SINK_ENABLED=false

# Legacy/lab direct flag. If spl_readonly is selected in CAPABILITY_PROFILES,
# the profile takes precedence over this baseline false value.
SPL_QUERY_GENERATION_ENABLED=false

# Enable SPL-dedicated RAG grounding for SPL generation. This is separate from
# general SOC RAG and uses a Splunk-focused source directory/table.
SPL_QUERY_RAG_ENABLED=false
SPL_QUERY_RAG_SOURCE_DIR=/opt/llm-notable-analysis/knowledge_base/spl_query_source_docs
SPL_QUERY_RAG_INDEX_DIR=/opt/llm-notable-analysis/knowledge_base/spl_query_index
SPL_QUERY_RAG_POSTGRES_CHUNKS_TABLE=spl_query_chunks
SPL_QUERY_RAG_MAX_SNIPPETS=4
SPL_QUERY_RAG_CONTEXT_BUDGET_CHARS=1600
# suppress: do not generate SPL if SPL grounding is enabled but unavailable.
# fallback_to_ungrounded: generate SPL without SPL_QUERY_GROUNDING_CONTEXT.
SPL_QUERY_RAG_FAILURE_MODE=suppress

# Splunk base URL (e.g., https://splunk.internal:8089)
SPLUNK_BASE_URL=

# Splunk API token for REST authentication
SPLUNK_API_TOKEN=

# Splunk notable update endpoint path
# Default works for many Splunk ES deployments; override if your environment differs.
SPLUNK_NOTABLE_UPDATE_PATH=/services/notable_update

# Path to PEM-format CA bundle for Splunk TLS verification.
# If your Splunk instance uses an internal/private CA not in the system trust
# store, set this to the path of your CA bundle (e.g., /etc/pki/tls/certs/internal-ca.pem).
# If empty, the system trust store is used (default, recommended if CA is installed system-wide).
# To install internal CA system-wide on RHEL: copy CA cert to /etc/pki/ca-trust/source/anchors/
# and run: sudo update-ca-trust
SPLUNK_CA_BUNDLE=

# =============================================================================
# Splunk Investigation Query Execution (Optional)
# =============================================================================
# Legacy/lab direct flag. If spl_readonly is selected in CAPABILITY_PROFILES,
# the profile takes precedence over this baseline false value.
INVESTIGATION_QUERY_EXECUTION_ENABLED=false

# Query executor mode: rest or mcp
INVESTIGATION_QUERY_EXECUTOR=rest

# Active read-only investigation backend: splunk or elasticsearch.
# v1 supports one active backend per deployment.
INVESTIGATION_QUERY_BACKEND=splunk

# Max generated hypothesis queries to attempt per alert
INVESTIGATION_MAX_QUERIES_PER_ALERT=6

# Max concurrent query executions per alert (matches default max queries per alert)
INVESTIGATION_MAX_CONCURRENT_QUERIES=6

# Optional third LLM call that interprets deterministic query execution results.
# Leave false for deterministic-only Query Results markdown.
QUERY_RESULT_INTERPRETATION_ENABLED=false

# Prompt guardrails for query-result interpretation. The LLM receives bounded,
# normalized query facts; confidence_delta is interpretation-only and does not
# modify existing confidence scores.
QUERY_RESULT_INTERPRETATION_CONTEXT_BUDGET_CHARS=4000
QUERY_RESULT_INTERPRETATION_MAX_SAMPLE_ROWS=3
QUERY_RESULT_INTERPRETATION_MAX_TOKENS=768

# Splunk REST search endpoint path (oneshot recommended for bounded reads)
SPLUNK_SEARCH_ENDPOINT_PATH=/services/search/jobs/oneshot

# Allowed and denied SPL policy controls (CSV lists)
SPLUNK_SEARCH_ALLOWED_INDEXES=main,notable,risk
SPLUNK_SEARCH_ALLOWED_COMMANDS=search,stats,table,fields,where,head
SPLUNK_SEARCH_DENIED_COMMANDS=delete,collect,outputlookup,sendemail,map,rest,script,dbxquery

# Query execution bounds
SPLUNK_SEARCH_MAX_TIME_RANGE=24h
SPLUNK_SEARCH_MAX_ROWS=100
SPLUNK_SEARCH_TIMEOUT_SECONDS=30

# MCP tool name used by the injected Splunk MCP client
SPLUNK_MCP_TOOL_NAME=splunk_search

# =============================================================================
# Elasticsearch Investigation Query Execution (Optional)
# =============================================================================
# Legacy/lab direct flag. If elastic_readonly is selected in CAPABILITY_PROFILES,
# the profile takes precedence over this baseline false value.
ELASTIC_QUERY_GENERATION_ENABLED=false

# Elasticsearch base URL (e.g., https://elastic.internal:9200)
ELASTICSEARCH_BASE_URL=

# Elasticsearch API key. Prefer a read-only key limited to _search on approved indexes.
ELASTICSEARCH_API_KEY=

# CSV allowlist of index names or patterns the analyzer may query.
ELASTICSEARCH_INDEX_ALLOWLIST=logs-auth,security-*

# Keep false unless operators deliberately allow wildcard index patterns.
ELASTICSEARCH_ALLOW_WILDCARD_INDEXES=false

# Timestamp field required in generated range filters.
ELASTICSEARCH_TIMESTAMP_FIELD=@timestamp

# CSV allowlist of fields the generated Query DSL may reference.
# Leave empty only for lab or alert/grounding-only validation.
ELASTICSEARCH_ALLOWED_FIELDS=@timestamp,user.name,host.name,source.ip,destination.ip,event.action,event.category

# Enable Elastic-dedicated RAG grounding for Query DSL generation. This is
# separate from general SOC RAG and uses an Elastic-focused source corpus/table.
ELASTICSEARCH_GROUNDING_ENABLED=false
ELASTICSEARCH_GROUNDING_SOURCE_DIR=/opt/llm-notable-analysis/knowledge_base/elasticsearch_source_docs
ELASTICSEARCH_GROUNDING_POSTGRES_CHUNKS_TABLE=elasticsearch_query_chunks
ELASTICSEARCH_GROUNDING_MAX_SNIPPETS=4
ELASTICSEARCH_GROUNDING_CONTEXT_BUDGET_CHARS=1600
# suppress: do not generate Elastic queries if Elastic grounding is enabled but unavailable.
# fallback_to_ungrounded: generate Elastic queries without ELASTICSEARCH_GROUNDING_CONTEXT.
ELASTICSEARCH_GROUNDING_FAILURE_MODE=suppress

# Elasticsearch query execution bounds
ELASTICSEARCH_MAX_TIME_RANGE=24h
ELASTICSEARCH_MAX_ROWS=100
ELASTICSEARCH_TIMEOUT_SECONDS=30

# Path to PEM-format CA bundle for Elasticsearch TLS verification.
# If empty, the system trust store is used.
ELASTICSEARCH_CA_BUNDLE=

# =============================================================================
# ServiceNow Incident Draft/Create (Optional)
# =============================================================================
# Legacy/lab direct flag. If ticket_draft or action_gated is selected in
# CAPABILITY_PROFILES, the profile takes precedence over this baseline false value.
SERVICENOW_DRAFT_ENABLED=false

# Legacy/lab direct flag. If action_gated is selected in CAPABILITY_PROFILES,
# the profile takes precedence over this baseline false value.
SERVICENOW_CREATE_ENABLED=false

# Require payload-level explicit approval metadata for create
SERVICENOW_CREATE_REQUIRES_APPROVAL=true

# ServiceNow API connection settings
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_CREATE_PATH=/api/now/table/incident
SERVICENOW_API_TOKEN=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_TIMEOUT_SECONDS=15

# Side-effect idempotency only applies to external writes/actions such as
# ServiceNow incident create and Splunk notable update.
SIDE_EFFECT_IDEMPOTENCY_ENABLED=false
SIDE_EFFECT_IDEMPOTENCY_DIR=/var/notables/idempotency
SIDE_EFFECT_IDEMPOTENCY_RETENTION_DAYS=30

# =============================================================================
# MITRE ATT&CK Data
# =============================================================================
# Path to pre-extracted TTP IDs JSON file
# Default uses bundled file in the installed src package tree
MITRE_IDS_PATH=/opt/notable-analyzer/src/llm_notable_analysis_onprem_systemd/onprem_service/enterprise_attack_v17.1_ids.json

# =============================================================================
# Retention Policy
# =============================================================================
# Stage 1: move old inputs/reports into ARCHIVE_DIR
INPUT_RETENTION_DAYS=2
REPORT_RETENTION_DAYS=7

# Stage 2: delete files from ARCHIVE_DIR after this many days in archive
ARCHIVE_RETENTION_DAYS=14

# How often to run retention housekeeping (seconds)
RETENTION_RUN_INTERVAL_SECONDS=86400

# =============================================================================
# Concurrency (Optional)
# =============================================================================
# RTX PRO 6000 (96 GB) + gemma-4-31B-it baseline: sequential first, then load-test
# CONCURRENCY_ENABLED=true with MAX_WORKERS=2 only after vLLM latency is acceptable.
# Enable concurrent notable processing via Python multithreading (ThreadPoolExecutor)
# Default is sequential (one notable at a time)
CONCURRENCY_ENABLED=false

# Number of worker threads (multithreading) when concurrency is enabled
# Starting points by profile:
# - Gemma 4 31B-it: start at 1; after load tests on A6000-class GPUs try 2
MAX_WORKERS=1

# Maximum pending files in queue before backpressure kicks in
# When queue is full, new files wait until next poll cycle
# Starting points by profile:
# - Gemma 4 31B-it: 8 at MAX_WORKERS=1; try 16 when MAX_WORKERS=2 after load tests
MAX_QUEUE_DEPTH=8

