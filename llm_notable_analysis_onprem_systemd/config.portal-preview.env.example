# Local analyst portal UI preview only. Copy to config.portal-preview.env and edit.
# config.portal-preview.env is gitignored; never commit real keys.

# Preview-only Bedrock chat (scripts/preview_portal_ui.py; not used by production portal):
PORTAL_LLM_PROVIDER=bedrock
PORTAL_PREVIEW_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
PORTAL_PREVIEW_BEDROCK_AWS_PROFILE=
AWS_REGION=us-east-1

# OpenAI chat synthesis (alternative; ignored when Bedrock preview settings are active):
PORTAL_PREVIEW_OPENAI_API_KEY=

# Alternative name also supported:
# OPENAI_API_KEY=

# Optional overrides (defaults shown):
PORTAL_PREVIEW_OPENAI_MODEL=gpt-4.1-mini
PORTAL_PREVIEW_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
