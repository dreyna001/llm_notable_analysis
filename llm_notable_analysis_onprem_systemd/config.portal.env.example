# Customer-default portal env. Mirror analyzer RAG/SPL/closed-ticket retrieval settings.
# See docs/operations/deployment/CUSTOMER_DEFAULT_DEPLOYMENT.md

CAPABILITY_PROFILES=core,analyst_portal

# Case archive read/retrieval database. Prefer a read-only portal role for this DSN.
CASE_POSTGRES_DSN=postgresql://notable_portal@127.0.0.1:5432/notable_rag
CASE_POSTGRES_SCHEMA=notable_cases
CASE_POSTGRES_STATEMENT_TIMEOUT_MS=5000
CASE_RETENTION_DAYS=30
CASE_RETENTION_DELETE_BATCH_SIZE=500

# Case Q&A defaults. Portal chat requires a pinned case.
CASE_QA_ENABLED=true
CASE_QA_CHAT_HISTORY_ENABLED=true
CASE_QA_MAX_SESSIONS_PER_USER=10
CASE_QA_CHAT_HISTORY_RETENTION_DAYS=30
CASE_QA_MAX_CHUNKS_PER_LANE=6
CASE_QA_MAX_TOTAL_CHUNKS=18
CASE_QA_CONTEXT_BUDGET_CHARS=12000
CASE_QA_MAX_QUESTION_CHARS=10000
CASE_QA_CHAT_IMAGES_ENABLED=true
CASE_QA_MAX_CHAT_IMAGES=1
CASE_QA_MAX_CHAT_IMAGE_BYTES=750000
CASE_QA_MAX_CHAT_IMAGE_DIMENSION=4096
CASE_QA_MAX_CHAT_IMAGE_PIXELS=16777216
CASE_QA_MAX_ANSWER_TOKENS=800
CASE_QA_MODEL_CONTEXT_TOKENS=128000
CASE_QA_EMBEDDING_MODEL=ibm-granite/granite-embedding-english-r2
CASE_QA_VECTOR_DIMENSIONS=768
# When true, fall back to broad technology answers when archive retrieval is empty or insufficient.
CASE_QA_GENERAL_KNOWLEDGE_ENABLED=true

# =============================================================================
# Portal chat Knowledge Base retrieval (mirror analyzer RAG contract)
# =============================================================================
RAG_ENABLED=true
RAG_FAIL_CLOSED=false
RAG_BACKEND=postgres
RAG_POSTGRES_DSN=postgresql://notable_portal@127.0.0.1:5432/notable_rag
RAG_POSTGRES_SCHEMA=notable_rag
RAG_POSTGRES_CHUNKS_TABLE=kb_chunks
RAG_POSTGRES_FTS_CONFIG=english
RAG_POSTGRES_STATEMENT_TIMEOUT_MS=5000
RAG_VECTOR_DIMENSIONS=768
RAG_EMBEDDING_MODEL=ibm-granite/granite-embedding-english-r2
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=ibm-granite/granite-embedding-reranker-english-r2
HF_HOME=/var/notables/cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/var/notables/cache/sentence-transformers
RAG_FUSED_RANK_LIMIT_120B=8
RAG_LEXICAL_TOP_K=30
RAG_VECTOR_TOP_K=30
RAG_RRF_K=60

SPL_QUERY_RAG_ENABLED=true
SPL_QUERY_RAG_POSTGRES_CHUNKS_TABLE=spl_query_chunks
SPL_QUERY_RAG_MAX_SNIPPETS=4
SPL_QUERY_RAG_CONTEXT_BUDGET_CHARS=1600

# Closed-ticket RAG lane for portal chat (pair with analyzer config.env).
CLOSED_TICKET_RAG_ENABLED=true
CLOSED_TICKET_POSTGRES_SCHEMA=notable_closed_tickets
CLOSED_TICKET_POSTGRES_CHUNKS_TABLE=ticket_chunks
CLOSED_TICKET_RAG_MAX_SNIPPETS=6
CLOSED_TICKET_RAG_CONTEXT_BUDGET_CHARS=6000
CASE_QA_CLOSED_TICKET_ENABLED=true
CASE_QA_CLOSED_TICKET_MAX_TICKETS=5

# Local LLM gateway for answer synthesis.
LLM_API_URL=http://127.0.0.1:4000/v1/chat/completions
LLM_API_TOKEN=
LLM_MODEL_NAME=gemma-4-31B-it
LLM_TIMEOUT=240

# Portal listener and reverse-proxy boundary.
PORTAL_BIND_HOST=127.0.0.1
PORTAL_PORT=8080
PORTAL_PAGE_SIZE=50
PORTAL_CHAT_MAX_CONCURRENCY=18
PORTAL_TRUSTED_USER_HEADER=X-Forwarded-User
PORTAL_ALLOW_NON_LOOPBACK_BIND=false
PORTAL_PROXY_SECRET=<generate-a-random-shared-secret>
PORTAL_PROXY_SECRET_HEADER=X-Notable-Portal-Proxy-Secret
