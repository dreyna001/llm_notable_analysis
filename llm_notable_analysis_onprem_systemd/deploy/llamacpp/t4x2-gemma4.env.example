# Runtime contract for Gemma 4 26B-A4B QAT Q4_0 on two NVIDIA T4 GPUs.
# Installed as /etc/notable-analyzer/llamacpp-gemma.env.
#
# The systemd unit keeps the security boundary and command-line shape fixed;
# these values expose only the hardware and bounded-capacity tuning controls.
CUDA_VISIBLE_DEVICES=0,1
LLAMACPP_TENSOR_SPLIT=1,1
LLAMACPP_CONTEXT_SIZE=16384
LLAMACPP_PARALLEL=1
LLAMACPP_THREADS=8
LLAMACPP_THREADS_BATCH=8
LLAMACPP_BATCH_SIZE=2048
LLAMACPP_UBATCH_SIZE=512

