[Unit]
Description=Notable Analyst Portal (read-only FastAPI)
Documentation=https://github.com/your-org/notable-analyzer
After=network.target litellm.service
Wants=litellm.service

[Service]
Type=simple
User=notable-analyzer
Group=notable-analyzer

WorkingDirectory=/opt/notable-analyzer
EnvironmentFile=/etc/notable-analyzer/portal.env
Environment=HF_HOME=/var/notables/cache/huggingface
Environment=SENTENCE_TRANSFORMERS_HOME=/var/notables/cache/sentence-transformers

ExecStart=/opt/notable-analyzer/venv/bin/python -m llm_notable_analysis_onprem_systemd.onprem_service.portal_app

TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=10

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/notable-analyzer
ReadWritePaths=/var/notables/cache

LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=notable-portal

[Install]
WantedBy=multi-user.target
