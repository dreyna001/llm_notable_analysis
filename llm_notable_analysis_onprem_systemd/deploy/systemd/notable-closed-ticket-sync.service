[Unit]
Description=Notable Analyzer ServiceNow Closed Ticket Raw Sync (oneshot)
Documentation=https://github.com/your-org/notable-analyzer
After=network.target postgresql.service

[Service]
Type=oneshot
User=notable-analyzer
Group=notable-analyzer

WorkingDirectory=/opt/notable-analyzer

EnvironmentFile=/etc/notable-analyzer/config.env

ExecStart=/opt/notable-analyzer/venv/bin/python /opt/notable-analyzer/scripts/run_closed_ticket_sync.py

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/notables /var/notables/closed_ticket_attachments

StandardOutput=journal
StandardError=journal
SyslogIdentifier=notable-closed-ticket-sync

[Install]
WantedBy=multi-user.target
