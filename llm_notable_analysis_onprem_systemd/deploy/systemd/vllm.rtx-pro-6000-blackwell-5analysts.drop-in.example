# vLLM systemd drop-in for RTX PRO 6000 Blackwell + 5 concurrent portal analysts
#
# This file does NOT replace deploy/systemd/vllm.service.
# Install on the host as:
#   sudo mkdir -p /etc/systemd/system/vllm.service.d
#   sudo cp vllm.rtx-pro-6000-blackwell-5analysts.drop-in.example /etc/systemd/system/vllm.service.d/override.conf
#   sudo systemctl daemon-reload
#   sudo systemctl restart vllm
#
# Pair with:
#   config.env.rtx-pro-6000-blackwell-5analysts.example
#   config.portal.env.rtx-pro-6000-blackwell-5analysts.example
#
# Exact customer-VM baseline:
#   vLLM 0.21.0, Python 3.12.11, CUDA toolkit at /usr/local/cuda-13.3
#   NVIDIA RTX PRO 6000 Blackwell Workstation Edition (97887 MiB)
#
# The conservative 0.85, bfloat16, and eager-mode values match the stable
# running VM. --max-num-seqs 4 bounds serving concurrency to the measured
# four-request benchmark shape. Validate again after any model/runtime update.
# Roll back to the prior drop-in backup if OOM or latency regressions appear.

[Service]
ExecStart=
ExecStart=/opt/vllm/venv/bin/python -m vllm.entrypoints.openai.api_server \
    --model /opt/models/gemma-4-31B-it \
    --served-model-name gemma-4-31B-it \
    --host 127.0.0.1 \
    --port 8000 \
    --gpu-memory-utilization 0.85 \
    --max-model-len 32768 \
    --max-num-seqs 4 \
    --dtype bfloat16 \
    --distributed-executor-backend mp \
    --enforce-eager

Environment="CUDA_HOME=/usr/local/cuda-13.3"
Environment="PATH=/usr/local/cuda-13.3/bin:/opt/vllm/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
