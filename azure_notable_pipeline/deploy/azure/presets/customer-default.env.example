# Azure Government customer-default Bicep preset (copy and fill)
#
# Matches on-prem CAPABILITY_PROFILES=core,rag,analyst_portal with general SOC
# RAG and pinned-case Q&A. Does not enable first-pass SPL generation, live SIEM
# queries, or closed-ticket RAG (P1-P8 flags below are commented off by default).
#
# Usage (bash):
#   cp deploy/azure/presets/customer-default.env.example customer-default.env
#   # edit customer-default.env
#   set -a && source customer-default.env && set +a
#   ./scripts/setup-and-deploy.sh
#
# Full checklist: docs/operations/deployment/AZURE_CUSTOMER_DEFAULT_DEPLOYMENT.md
# Azure AI Search first: docs/operations/deployment/AZURE_GOVERNMENT_CUSTOMER_CONFIGURATION.md

# --- Required: subscription and deployment context ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_DEPLOYMENT_PREFIX=
AZURE_LOCATION=usgovvirginia
# Optional; defaults to deployment-results/<deployment-name>.json.
# Store the completed report in the customer's approved evidence system.
# DEPLOYMENT_REPORT_PATH=

# --- Required: container image (publish to ACR before deploy) ---
CONTAINER_REGISTRY_RESOURCE_ID=
CONTAINER_IMAGE_URI=

# --- Required: Azure OpenAI (Government endpoint) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_RESOURCE_ID=
AZURE_OPENAI_ANALYSIS_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
AZURE_OPENAI_PORTAL_CHAT_DEPLOYMENT=

# --- Required: storage accounts (globally unique) ---
FUNCTIONS_HOST_STORAGE_ACCOUNT_NAME=
INPUT_STORAGE_ACCOUNT_NAME=
OUTPUT_STORAGE_ACCOUNT_NAME=

# --- Required: Cosmos DB ---
COSMOS_ACCOUNT_NAME=
COSMOS_DATABASE_NAME=

# --- Required: analyst portal and CaseIndex ---
CAPABILITY_PROFILES=core,rag,analyst_portal
STORAGE_ACCOUNT_NAME_PORTAL_UI=
PORTAL_UI_STORAGE_ACCOUNT_NAME=
PORTAL_UI_DEPLOYER_PRINCIPAL_ID=
PORTAL_JWT_ISSUER=
PORTAL_JWT_AUDIENCE=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_AUTHORITY=
PORTAL_OIDC_API_SCOPE=
PORTAL_ENTRA_REQUIRED_APP_ROLE=
PORTAL_VALIDATION_BEARER_TOKEN=

# --- Required: Azure AI Search (customer-provisioned; stack references only) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_RESOURCE_ID=
RAG_TENANT_ID=
RAG_AZURE_SEARCH_INDEX=
CASE_QA_AZURE_SEARCH_INDEX=
RAG_SOURCE_STORAGE_ACCOUNT_NAME=
RAG_SOURCE_STORAGE_ACCOUNT_URL=
RAG_SOURCE_CONTAINER=

# --- Optional: closed-ticket RAG (P3-P8; default off) ---
# SERVICENOW_CLOSED_TICKET_SYNC_ENABLED=false
# CLOSED_TICKET_RAG_ENABLED=false
# IMAGE_INGEST_ENABLED=false
# RAG_RERANK_ENABLED=false
# CASE_QA_CLOSED_TICKET_ENABLED=false
# CASE_QA_CHAT_IMAGES_ENABLED=false
# CLOSED_TICKET_VISION_ENABLED=false
# ServiceNowClosedTicketQuery=
# ServiceNowClosedTicketTokenSecretName=
# ClosedTicketAzureSearchIndex=closed_tickets
# ClosedTicketRetentionDays=30

# --- Optional: ServiceNow disposition sync (separate from closed-ticket RAG) ---
# SERVICENOW_DISPOSITION_SYNC_ENABLED=false
# KEY_VAULT_NAME=
# SERVICENOW_DISPOSITION_SYNC_TOKEN_SECRET_NAME=
