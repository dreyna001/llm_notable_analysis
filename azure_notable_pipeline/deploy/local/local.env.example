# Public local-emulator settings only. Copy to local.env to override ports or names.
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.35.0
COSMOS_EMULATOR_IMAGE=mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator:vnext-latest

# Azurite's documented development account. It is local-only, not a secret.
LOCAL_EMULATION=true
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true
AzureWebJobsStorage=UseDevelopmentStorage=true
InputStorage=UseDevelopmentStorage=true
OutputStorage=UseDevelopmentStorage=true
INPUT_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
INPUT_CONTAINER_NAME=input
OUTPUT_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
OUTPUT_CONTAINER_NAME=output
ANALYZER_QUEUE_NAME=notable-analysis-jobs
CASE_EMBED_QUEUE_NAME=case-embed-invocations

# Well-known public key for the local Cosmos DB emulator; never reuse remotely.
COSMOS_ENDPOINT=http://127.0.0.1:8081
# Alias consumed by the opt-in tests/integration local parity harness.
COSMOS_EMULATOR_ENDPOINT=http://127.0.0.1:8081
COSMOS_EMULATOR_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE_NAME=notable-local
SIDE_EFFECT_IDEMPOTENCY_CONTAINER=notable-side-effect-idempotency
CASE_INDEX_CONTAINER=local-case-index
DISPOSITION_CONTAINER=local-servicenow-dispositions
DISPOSITION_SYNC_STATE_CONTAINER=local-disposition-sync-state
CHAT_SESSIONS_CONTAINER=local-chat-sessions
CHAT_MESSAGES_CONTAINER=local-chat-messages
