# Azure Notable Pipeline Runtime Contract
#
# Bicep parameters are the official deployment path. Function Apps receive
# these values as environment variables after deployment. Do not commit secrets;
# pass secret names and store customer integration secret values in Azure Key Vault.

# =============================================================================
# Capability Profiles
# =============================================================================
# Supported: core, html_reports, rag, spl_readonly, elastic_readonly, ticket_draft, action_gated, analyst_portal
CAPABILITY_PROFILES=core

# =============================================================================
# Core Azure Functions / Azure AI Foundry Analysis And Azure OpenAI
# =============================================================================
AZURE_AI_FOUNDRY_ANTHROPIC_BASE_URL=
AZURE_AI_FOUNDRY_RESOURCE_ID=
AZURE_AI_FOUNDRY_ANALYSIS_DEPLOYMENT=claude-sonnet-4-6
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_PORTAL_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
REPORT_SINK_MODE=blob
INPUT_STORAGE_ACCOUNT_URL=
INPUT_CONTAINER_NAME=input
OUTPUT_STORAGE_ACCOUNT_URL=
OUTPUT_CONTAINER_NAME=output
ANALYZER_QUEUE_NAME=notable-analysis-jobs
CASE_EMBED_QUEUE_NAME=case-embed-invocations

# Bicep-managed identity-based Functions binding settings. InputStorage needs
# both private Blob and Queue endpoints because the polling Blob trigger uses
# the queue service for receipts and webjobs-blobtrigger-poison. OutputStorage
# owns notable-analysis-jobs and case-embed-invocations. Never replace these
# values with storage connection strings or account keys.
InputStorage__blobServiceUri=
InputStorage__queueServiceUri=
InputStorage__credential=managedidentity
InputStorage__clientId=
OutputStorage__queueServiceUri=
OutputStorage__credential=managedidentity
OutputStorage__clientId=
COSMOS_ENDPOINT=
COSMOS_DATABASE_NAME=
AZURE_SEARCH_ENDPOINT=
KEY_VAULT_URI=
OUTPUT_PREFIX=reports
MAX_DECOMPRESSED_INPUT_BYTES=1048576
ALLOW_PRIVATE_OUTBOUND_ENDPOINTS=false

# =============================================================================
# HTML Reports (Optional)
# =============================================================================
HTML_REPORT_ENABLED=false

# =============================================================================
# General RAG via Azure AI Search (Optional)
# =============================================================================
RAG_ENABLED=false
RAG_AZURE_SEARCH_INDEX=
RAG_MAX_SNIPPETS=4
RAG_CONTEXT_BUDGET_CHARS=1600
RAG_FAILURE_MODE=suppress

# =============================================================================
# Splunk Writeback (Optional External Write)
# =============================================================================
SPLUNK_BASE_URL=
SPLUNK_API_TOKEN_SECRET_NAME=
SPLUNK_API_TOKEN_SECRET_FIELD=token
SPLUNK_NOTABLE_UPDATE_PATH=/services/notable_update
SPLUNK_SINK_ENABLED=false
SPLUNK_REQUIRE_PAYLOAD_FINDING_ID=false

# =============================================================================
# SPL Generation, Grounding, And Read-Only Investigation (Optional)
# =============================================================================
SPL_QUERY_GENERATION_ENABLED=false
SPL_QUERY_RAG_ENABLED=false
SPL_QUERY_AZURE_SEARCH_INDEX=
SPL_QUERY_RAG_MAX_SNIPPETS=4
SPL_QUERY_RAG_CONTEXT_BUDGET_CHARS=1600
SPL_QUERY_RAG_FAILURE_MODE=suppress

INVESTIGATION_QUERY_EXECUTION_ENABLED=false
INVESTIGATION_QUERY_BACKEND=splunk
INVESTIGATION_QUERY_EXECUTOR=rest
INVESTIGATION_MAX_QUERIES_PER_ALERT=6
INVESTIGATION_MAX_CONCURRENT_QUERIES=6

SPLUNK_SEARCH_ENDPOINT_PATH=/services/search/jobs/oneshot
SPLUNK_SEARCH_ALLOWED_INDEXES=main,notable,risk
SPLUNK_SEARCH_ALLOWED_COMMANDS=search,stats,table,fields,where,head
SPLUNK_SEARCH_DENIED_COMMANDS=delete,collect,outputlookup,sendemail,map,rest,script,dbxquery,inputlookup
SPLUNK_SEARCH_ALLOWED_FIELDS=
SPLUNK_SEARCH_MAX_TIME_RANGE=24h
SPLUNK_SEARCH_MAX_ROWS=100
SPLUNK_SEARCH_TIMEOUT_SECONDS=30

SPLUNK_MCP_ENDPOINT=
SPLUNK_MCP_AUTH_SECRET_NAME=
SPLUNK_MCP_AUTH_SECRET_FIELD=token
SPLUNK_MCP_HTTP_TIMEOUT_SECONDS=35
SPLUNK_MCP_TOOL_NAME=splunk_search

# =============================================================================
# Query Result Interpretation (Optional)
# =============================================================================
QUERY_RESULT_INTERPRETATION_ENABLED=false
QUERY_RESULT_INTERPRETATION_CONTEXT_BUDGET_CHARS=4000
QUERY_RESULT_INTERPRETATION_MAX_SAMPLE_ROWS=3
QUERY_RESULT_INTERPRETATION_MAX_TOKENS=768

# =============================================================================
# Elasticsearch Read-Only Investigation (Optional)
# =============================================================================
ELASTIC_QUERY_GENERATION_ENABLED=false
ELASTICSEARCH_BASE_URL=
ELASTICSEARCH_API_KEY_SECRET_NAME=
ELASTICSEARCH_INDEX_ALLOWLIST=
ELASTICSEARCH_ALLOW_WILDCARD_INDEXES=false
ELASTICSEARCH_TIMESTAMP_FIELD=@timestamp
ELASTICSEARCH_ALLOWED_FIELDS=
ELASTICSEARCH_GROUNDING_ENABLED=false
ELASTICSEARCH_GROUNDING_AZURE_SEARCH_INDEX=
ELASTICSEARCH_GROUNDING_MAX_SNIPPETS=4
ELASTICSEARCH_GROUNDING_CONTEXT_BUDGET_CHARS=1600
ELASTICSEARCH_GROUNDING_FAILURE_MODE=suppress
ELASTICSEARCH_MAX_TIME_RANGE=24h
ELASTICSEARCH_MAX_ROWS=100
ELASTICSEARCH_TIMEOUT_SECONDS=30

# =============================================================================
# ServiceNow Draft/Create (Optional External Action)
# =============================================================================
SERVICENOW_DRAFT_ENABLED=false
SERVICENOW_CREATE_ENABLED=false
SERVICENOW_CREATE_REQUIRES_APPROVAL=true
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_CREATE_PATH=/api/now/table/incident
SERVICENOW_API_TOKEN_SECRET_NAME=
SERVICENOW_APPROVAL_HMAC_SECRET_NAME=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_TIMEOUT_SECONDS=15

# =============================================================================
# ServiceNow Closed Disposition Sync (Optional, Read-Only Inbound)
# =============================================================================
# Scheduled Function pulls closed security incidents into Cosmos DB. Default off.
# Use a read-only Table API token; do not reuse SERVICENOW_API_TOKEN_SECRET_NAME.
SERVICENOW_DISPOSITION_SYNC_ENABLED=false
SERVICENOW_DISPOSITION_SYNC_TOKEN=
SERVICENOW_DISPOSITION_SYNC_TOKEN_SECRET_NAME=
SERVICENOW_DISPOSITION_FIELD_MAP=
SERVICENOW_DISPOSITION_CODE_MAP=
SERVICENOW_DISPOSITION_BACKFILL_DAYS=90
DISPOSITION_RETENTION_DAYS=365
DISPOSITION_CONTAINER=
DISPOSITION_SYNC_STATE_CONTAINER=

# =============================================================================
# Side-Effect Idempotency (External Writes/Actions Only)
# =============================================================================
SIDE_EFFECT_IDEMPOTENCY_ENABLED=false
SIDE_EFFECT_IDEMPOTENCY_CONTAINER=
SIDE_EFFECT_IDEMPOTENCY_RETENTION_DAYS=30
SIDE_EFFECT_IDEMPOTENCY_LOCK_SECONDS=900

# =============================================================================
# Case Archive And Analyst Portal (Optional, Wave 2)
# =============================================================================
# The analyst_portal profile enables CASE_ARCHIVE_ENABLED, PORTAL_ENABLED, and
# CASE_QA_ENABLED. It does not enable HTML reports or external writeback paths.
CASE_ARCHIVE_ENABLED=false
CASE_ARCHIVE_FAILURE_MODE=suppress
CASE_ARCHIVE_CONTAINER=output
CASE_ARCHIVE_PREFIX=cases
CASE_ARCHIVE_CHUNKS_PREFIX=case_chunks
CASE_INDEX_CONTAINER=
CASE_RETENTION_DAYS=30
CASE_SCHEMA_VERSION=1
CASE_ANALYSIS_SCHEMA_VERSION=1
CASE_ARCHIVE_MAX_ALERT_BYTES=262144
CASE_ARCHIVE_MAX_ANALYSIS_BYTES=524288

PORTAL_ENABLED=false
PORTAL_AUTH_MODE=jwt
PORTAL_PAGE_SIZE=50
PORTAL_MAX_DETAIL_BYTES=262144
PORTAL_JWT_ISSUER=
PORTAL_JWT_AUDIENCE=
PORTAL_ENTRA_REQUIRED_APP_ROLE=
PORTAL_CORS_ALLOWED_ORIGINS=
PORTAL_CHAT_TIMEOUT_SEC=225
PORTAL_CHAT_MAX_CONCURRENCY=18

CASE_QA_ENABLED=false
CASE_QA_GENERAL_KNOWLEDGE_ENABLED=true
CASE_QA_MAX_INDEX_CHUNKS_PER_CASE=200
CASE_QA_MAX_CHUNKS_PER_LANE=6
CASE_QA_MAX_TOTAL_CHUNKS=18
CASE_QA_LEXICAL_TOP_K=30
CASE_QA_VECTOR_TOP_K=30
CASE_QA_RRF_K=60
CASE_QA_CONTEXT_BUDGET_CHARS=12000
CASE_QA_MAX_QUESTION_CHARS=2000
CASE_QA_MAX_ANSWER_TOKENS=800
CASE_QA_MODEL_CONTEXT_TOKENS=128000
CASE_QA_VECTOR_DIMENSIONS=1024
CASE_QA_EMBED_NORMALIZE=true
CASE_QA_CHAT_HISTORY_ENABLED=false
CASE_QA_CHAT_HISTORY_RETENTION_DAYS=30
CASE_QA_MAX_SESSIONS_PER_USER=10
CASE_QA_MAX_MESSAGES_PER_SESSION=30
CASE_QA_MAX_STORED_MESSAGE_BYTES=4000
CHAT_SESSIONS_CONTAINER=
CHAT_MESSAGES_CONTAINER=

RAG_RERANK_ENABLED=false
